# Pourquoi cette ligne existe
#
# Expo SDK 57 epingle react@19.2.3, alors que react-dom (pair *facultatif* de
# expo, utile au seul rendu web) reclame react@^19.3.0. Le conflit est sans
# consequence sur Android et iOS, ou react-dom n'est jamais charge.
#
# Sans ce reglage, npm tente d'installer react-dom@19.3.0, detecte un conflit
# de pairs, puis declare le verrouillage desynchronise : `npm ci` echoue et la
# compilation EAS s'arrete des l'etape « Install dependencies ».
#
# Ce fichier est lu par npm partout, y compris sur les serveurs de compilation :
# c'est le seul endroit ou ce choix doit etre ecrit.
legacy-peer-deps=true
