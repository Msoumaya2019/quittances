{
  "expo": {
    "name": "Quittances",
    "slug": "quittances-loyer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "quittances",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#059669",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.montmagny.quittances",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "L'application utilise Face ID pour proteger l'acces a vos donnees locatives. Vos donnees restent sur votre telephone.",
        "CFBundleLocalizations": [
          "fr"
        ],
        "CFBundleDevelopmentRegion": "fr"
      }
    },
    "android": {
      "package": "fr.montmagny.quittances",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ECFDF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "L'application utilise Face ID pour proteger l'acces a vos donnees locatives."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accede a vos photos uniquement pour y choisir l'image de votre signature. Aucune photo n'est transmise : tout reste sur votre telephone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd49cbec-941f-4c3a-84e8-7d1c4214fbb8"
      }
    },
    "owner": "axox93"
  }
}
